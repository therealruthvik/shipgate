# --- Slack (from your app config page) ---
# OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information -> App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...
# Channel where approval requests are posted (right-click channel -> Copy link -> last segment). Invite the bot!
SHIPGATE_CHANNEL_ID=C0123456789

# --- API auth for CI. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SHIPGATE_API_TOKEN=change-me

# --- Database ---
DATABASE_URL=postgresql://shipgate:shipgate@localhost:5432/shipgate

# --- Approval policy ---
# Slack user IDs allowed to approve (profile -> ... -> Copy member ID), comma separated
SHIPGATE_APPROVER_IDS=
# And/or a Slack user group ID (e.g. S0123ABC); members can approve
SHIPGATE_APPROVER_USERGROUP=
SHIPGATE_REQUIRED_APPROVALS=production=2,staging=1
SHIPGATE_DEFAULT_REQUIRED_APPROVALS=1
SHIPGATE_TIMEOUT_MINUTES=30
SHIPGATE_ALLOW_SELF_APPROVAL=false
